{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ue-asset-atlas.dev/schemas/item.schema.json",
  "title": "Asset Archive Item",
  "type": "object",
  "required": ["schema", "id", "project_id", "name", "kind"],
  "properties": {
    "schema": {"const": "blacklion.asset-archive.item.v1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "name": {"type": "string", "minLength": 1},
    "folder": {"type": "string"},
    "kind": {"enum": ["object", "space"]},
    "status": {"type": "string"},
    "source_file": {"type": "string"},
    "preview_fbx": {"type": "string"},
    "preview_assets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "thumbnail": {"type": "string"},
    "files": {"type": "array", "items": {"type": "object", "required": ["path"], "properties": {"label": {"type": "string"}, "path": {"type": "string"}}, "additionalProperties": false}},
    "todos": {"type": "array", "items": {"type": "string"}, "maxItems": 24},
    "pbr_channels": {"type": "array", "items": {"enum": ["base_color", "normal", "roughness", "metallic", "height", "ambient_occlusion", "emissive"]}}
  },
  "oneOf": [
    {"required": ["preview_fbx"], "not": {"required": ["preview_assets"]}},
    {"required": ["preview_assets"], "not": {"required": ["preview_fbx"]}},
    {"properties": {"kind": {"const": "space"}}, "required": ["kind", "source_file", "thumbnail"]}
  ],
  "additionalProperties": true
}
